# Copy to .env and fill in only what you use. With nothing set, the app runs on the built-in simulator.

# SIMULATOR, XENDIT, or MIDTRANS: the gateway used for every channel unless routed elsewhere.
PAYMENTS_DEFAULT_PROVIDER=SIMULATOR
# Where e-wallet apps send the customer back; {orderId} is replaced.
PAYMENTS_RETURN_URL=http://localhost:3000/orders/{orderId}

# Bearer token for /api/admin (the web admin signs in with it).
ADMIN_TOKEN=change-me

# PostgreSQL; leave commented out for the in-memory H2 database.
# For Supabase use the session pooler, because the direct db.<ref>.supabase.co host is IPv6-only.
# DATABASE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DATABASE_USERNAME=postgres.<project-ref>
# DATABASE_PASSWORD=
# Keeps app tables out of Supabase's public schema, which its Data API exposes.
# DATABASE_SCHEMA=payments

# Google sign-in: the Firebase project ID (Project settings > General).
FIREBASE_PROJECT_ID=
# Name-and-email sign-in for local runs. Set to false in production.
AUTH_DEV_LOGIN_ENABLED=true
AUTH_SESSION_TTL=P7D

# Sessions in Upstash Redis (Database > REST API). Empty = in memory, lost on restart.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Xendit test mode: Dashboard > Settings > API keys, and Settings > Webhooks for the verification token.
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# Midtrans sandbox: Dashboard > Settings > Access keys.
MIDTRANS_SERVER_KEY=
MIDTRANS_BASE_URL=https://api.sandbox.midtrans.com

# Turn the simulator endpoints off in production.
PAYMENTS_SIMULATOR_ENABLED=true
PAYMENTS_SIMULATOR_SECRET=change-me
